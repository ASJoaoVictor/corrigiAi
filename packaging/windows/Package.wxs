<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall">
  <Package Name="$(var.ProductName)" Manufacturer="corrigiAi" Version="$(var.AppVersion)"
           UpgradeCode="$(var.UpgradeCode)" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do corrigiAi já está instalada." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallName)">
        <Component Id="Launcher" Guid="*" Bitness="always64">
          <File Id="LauncherExe" Source="$(var.DistDir)\corrigiAi.exe" KeyPath="yes">
            <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="$(var.ProductName)" WorkingDirectory="INSTALLFOLDER" Advertise="yes" />
            <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="$(var.ProductName)" WorkingDirectory="INSTALLFOLDER" Advertise="yes" />
            <fire:FirewallException Id="LocalServerFirewall" Name="$(var.ProductName) Local Server"
                Port="$(var.AppPort)" Protocol="tcp" Profile="private" Scope="localSubnet" IgnoreFailure="no" />
          </File>
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
    <Feature Id="Main" Title="corrigiAi" Level="1">
      <ComponentRef Id="Launcher" />
      <ComponentGroupRef Id="Payload" />
    </Feature>
  </Package>
</Wix>
