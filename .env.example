SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# No Compose, coloque o hash entre aspas simples para preservar os caracteres $.
# Vazio usa instance/database.db localmente; na Vercel configure explicitamente.
# No Docker, vazio usa sqlite:////app/data/database.db via Compose.
DATABASE_URL=
# Opcionais fora do Docker; Compose configura estes caminhos no container.
WORK_DIR=
OCR_MODEL_DIR=
COOKIE_SECURE=false
DEBUG_OMR=false
PORT=5000
