# O instalador gera SECRET_KEY e o hash da senha. Não compartilhe o .env.
SECRET_KEY=
ADMIN_USERNAME=admin
# Use aspas simples ao preencher o hash manualmente.
ADMIN_PASSWORD_HASH=

# Obrigatória: connection string PostgreSQL do Supabase, entre aspas simples.
DATABASE_URL=

# Opcionais; o Docker configura os caminhos automaticamente.
WORK_DIR=
OCR_MODEL_DIR=
COOKIE_SECURE=false
DEBUG_OMR=false
# Apenas para python run.py; no Docker, a porta é 8000.
PORT=5000
