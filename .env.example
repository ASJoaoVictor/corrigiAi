SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# No Compose, coloque o hash entre aspas simples para preservar os caracteres $.
# O instalador solicita a conexão PostgreSQL do Supabase. Não inclua credenciais no Git.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Opcionais fora do Docker; Compose configura estes caminhos no container.
WORK_DIR=
OCR_MODEL_DIR=
COOKIE_SECURE=false
DEBUG_OMR=false
PORT=5000
